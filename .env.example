# --- AMBIENTE & SITE ---
PORT=3006
NEXT_PUBLIC_SITE_URL=http://localhost:3006

# --- SUPABASE / POSTGRESQL (BANCO & AUTH) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- PRISMA / SUPABASE ---
# DATABASE_URL = pooled (porta 6543, pgbouncer=true)
# DATABASE_URL_UNPOOLED = direta (porta 5432) para prisma migrate deploy
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- MERCADO PAGO INTEGRATION (PAGAMENTO OFICIAL) ---
# Checkout transparente: token no servidor + public key no Brick de cartão
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Secret de assinatura do webhook (não é o access token).
# Painel Mercado Pago → Sua conta → Suas integrações → Webhooks → Secret de assinatura.
# Sem este valor o webhook falha fechado (401) e nenhum pedido é marcado como pago.
MERCADOPAGO_WEBHOOK_SECRET=

# --- OPENAI (Amanda — server-only, never prefix with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
