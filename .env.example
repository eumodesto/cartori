# --- AMBIENTE & SITE ---
PORT=3006
NEXT_PUBLIC_SITE_URL=http://localhost:3006

# --- SUPABASE / POSTGRESQL (BANCO & AUTH) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- PRISMA DATABASE URL ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/cartori?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/cartori?schema=public"

# --- MERCADO PAGO INTEGRATION (PAGAMENTO OFICIAL) ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# --- OPENAI (Amanda — server-only, never prefix with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
